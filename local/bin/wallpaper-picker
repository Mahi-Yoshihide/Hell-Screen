#!/usr/bin/python
import curses
import re
import subprocess
from pathlib import Path

WALLPAPER_DIR = Path.home() / "Imagens/wallpaper"
EXTENSIONS = {".png", ".jpg", ".jpeg", ".webp", ".avif"}


def kitty_image(*args):
    return subprocess.run(
        ["kitty", "+kitten", "icat", *args],
        stdout=None,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def main(stdscr):
    curses.curs_set(0)
    stdscr.keypad(True)

    images = sorted(
        (p for p in WALLPAPER_DIR.iterdir()
         if p.is_file() and p.suffix.lower() in EXTENSIONS),
        key=lambda p: p.name.lower(),
    )

    if not images:
        stdscr.addstr(0, 0, f"Nenhuma imagem em {WALLPAPER_DIR}")
        stdscr.getch()
        return

    selected = 0
    offset = 0

    try:
        while True:
            # Limpa a prévia anterior antes de redesenhar a interface.
            kitty_image("--clear")
            stdscr.erase()

            height, width = stdscr.getmaxyx()
            list_width = min(max(20, width // 2), max(20, width - 15))
            list_width = min(list_width, width - 1)
            visible = max(1, height - 4)

            stdscr.addnstr(0, 0, " WALLPAPER PICKER ", width - 1, curses.A_BOLD)
            stdscr.addnstr(
                1, 0, "↑ ↓ navegar   Enter aplicar   Esc sair",
                max(1, list_width - 1),
            )

            # Separador e título da área de prévia.
            if list_width + 1 < width:
                stdscr.vline(2, list_width, curses.ACS_VLINE, max(1, height - 3))
                stdscr.addnstr(
                    1, list_width + 2, "PRÉVIA",
                    max(1, width - list_width - 3), curses.A_BOLD,
                )

            if selected < offset:
                offset = selected
            if selected >= offset + visible:
                offset = selected - visible + 1

            for row, idx in enumerate(
                range(offset, min(len(images), offset + visible)), 2
            ):
                attr = curses.A_REVERSE if idx == selected else curses.A_NORMAL
                stdscr.addnstr(row, 0, images[idx].name,
                               max(1, list_width - 1), attr)

            stdscr.addnstr(
                height - 1, 0,
                f"{selected + 1}/{len(images)}  {images[selected].name}",
                max(1, width - 1),
            )
            stdscr.refresh()

            # Mostra a imagem selecionada na metade direita do terminal.
            preview_left = list_width + 2
            preview_top = 3
            preview_width = width - preview_left - 1
            preview_height = height - preview_top - 2

            if preview_width >= 5 and preview_height >= 3:
                kitty_image(
                    "--place",
                    f"{preview_width}x{preview_height}@{preview_left}x{preview_top}",
                    str(images[selected]),
                )

            key = stdscr.getch()

            if key in (curses.KEY_UP, ord("k")):
                selected = (selected - 1) % len(images)
            elif key in (curses.KEY_DOWN, ord("j")):
                selected = (selected + 1) % len(images)
            elif key in (27, ord("q")):
                break
            elif key in (curses.KEY_ENTER, 10, 13):
                image = str(images[selected])

                try:
                    result = subprocess.run(
                        ["magick", image, "-resize", "25%",
                         "-colorspace", "Gray", "-threshold", "35%",
                         "-format", "%[fx:1-mean]", "info:"],
                        capture_output=True, text=True, check=True,
                    )
                    dark_ratio = float(result.stdout.strip())
                    mode = "dark" if dark_ratio >= 0.60 else "light"

                    subprocess.run(
                        ["matugen", "image", image, "--mode", mode,
                         "--prefer", "saturation"],
                        check=True,
                    )
                    subprocess.run(
                        ["hyprctl", "reload"],
                        check=True,
                    )


                    subprocess.run(
                        ["hyprctl", "hyprpaper", "wallpaper",
                         f"DP-2,{image}"],
                        check=True,
                    )

                    config = Path.home() / ".config/hypr/hyprpaper.conf"
                    if config.is_file():
                        content = config.read_text()
                        content = re.sub(
                            r"(?m)^(\s*path\s*=\s*).*$",
                            lambda m: m.group(1) + image,
                            content,
                        )
                        config.write_text(content)

                    subprocess.run(["pkill", "-x", "waybar"], check=False)
                    subprocess.run(["sleep", "0.5"], check=False)
                    subprocess.Popen(
                        ["waybar"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True,
                    )
                    subprocess.run(
                        ["notify-send", "Wallpaper atualizado",
                         f"Modo {mode} aplicado; Matugen e Waybar atualizados."],
                        check=False,
                    )
                except (subprocess.CalledProcessError, ValueError) as exc:
                    subprocess.run(
                        ["notify-send", "Erro ao atualizar wallpaper", str(exc)],
                        check=False,
                    )
                break
    finally:
        kitty_image("--clear")


if __name__ == "__main__":
    import os
    import signal

    curses.wrapper(main)

    # Encerra somente o Kitty que iniciou este picker.
    parent_pid = os.getppid()
    try:
        os.kill(parent_pid, signal.SIGTERM)
    except ProcessLookupError:
        passq